{
	"name": "Theia Cloud",
	"dockerFile": "Dockerfile",
	"context": "..",
	"remoteUser": "theia",
	"workspaceFolder": "/project",
    "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind,consistency=delegated",
	"runArgs": ["-h","theia","--add-host=host.docker.internal:host-gateway"],
    "remoteEnv": {
      "FLASK_DEBUG": "true",
      "FLASK_APP": "service:app",
	  "PYTHONIOENCODING": "utf-8",
	  "DATABASE_URI": "postgresql://postgres:postgres@host.docker.internal:5432/postgres",
	  "PATH": "/home/theia/venv/bin:${containerEnv:PATH}",
	  "VIRTUAL_ENV": "/home/theia/venv"
    },
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"CucumberOpen.cucumber-official",
				"yzhang.markdown-all-in-one",
				"bierner.github-markdown-preview",
				"hnw.vscode-auto-open-markdown-preview",
				"DavidAnson.vscode-markdownlint",
				"donjayamanne.githistory",
				"GitHub.vscode-pull-request-github",
				"hbenl.vscode-test-explorer",
				"njpwerner.autodocstring",
				"cstrap.flask-snippets",
				"wholroyd.jinja",
				"redhat.vscode-yaml",
				"ms-azuretools.vscode-docker",
				"streetsidesoftware.code-spell-checker"
			]
		}
	},
	"postCreateCommand": "bash /project/.devcontainer/bootstrap.sh",
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	]
}
